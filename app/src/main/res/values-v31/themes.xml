<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the same launch theme as values/themes.xml, but with the logo animating in,
         and "VEGAM STORIES" under it (the system splash's branding image, 200×80dp; not
         available on older Android). -->
    <style name="Theme.Vegam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vegam_navy</item>
        <!-- The logo coming in (splash_logo_animated); older Android shows it still. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
