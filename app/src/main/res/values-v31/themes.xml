<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the same launch theme as values/themes.xml, plus "VEGAM STORIES" under the
         logo (the system splash's branding image, 200×80dp; not available on older Android). -->
    <style name="Theme.Vegam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vegam_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
