<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 and up: everything is backed up and moved to a new phone except the app's logs
   (files/logs/, see core/logging/LogFiles.kt), which only matter on this phone.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
