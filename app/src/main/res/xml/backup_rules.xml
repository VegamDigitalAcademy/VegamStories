<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower: everything is backed up except the app's logs (files/logs/, see
   core/logging/LogFiles.kt), which only matter on this phone and are deleted after a week anyway.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="logs/" />
</full-backup-content>
