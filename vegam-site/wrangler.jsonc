{
  // Cloudflare Worker for vegamstories.com: the home page, the privacy policy and the terms.
  // Static files only, no Worker code, so Cloudflare serves them for free.
  // Deploy: npx wrangler deploy        (see README.md for the one-time setup)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vegam-site",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    // /privacy serves privacy.html, and /privacy.html redirects to /privacy.
    "html_handling": "auto-trailing-slash",
    // Unknown addresses get public/404.html, with status 404.
    "not_found_handling": "404-page"
  },

  // Only on your own domain, never on *.workers.dev. Deploy creates the DNS records for both.
  "routes": [
    { "pattern": "vegamstories.com", "custom_domain": true },
    { "pattern": "www.vegamstories.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
